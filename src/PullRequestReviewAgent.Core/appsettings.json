{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Analysis": {
    "MaxFileSizeBytes": 1048576,
    "SupportedFileExtensions": [
      ".cs",
      ".js",
      ".ts",
      ".py",
      ".java",
      ".cpp",
      ".c",
      ".h",
      ".hpp",
      ".go",
      ".rs",
      ".php",
      ".rb",
      ".swift",
      ".kt"
    ],
    "ExcludedDirectories": [
      "node_modules",
      "bin",
      "obj",
      ".git",
      "packages",
      "dist",
      "build"
    ]
  },
  "AIAnalysis": {
    "Enabled": true,
    "OpenAIApiKey": "",
    "Model": "gpt-4.1-nano",
    "CodingGuidelinesUrl": "",
    "MaxFileSizeBytes": 50000,
    "EnableBatchAnalysis": true
  }
}
